# Ignore build output
bin/
obj/
*.dacpac

# Ignore user-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Ignore NuGet packages
packages/
*.nupkg
project.lock.json
project.fragment.lock.json
artifacts/

# VS Code settings
.vscode/

# Docker-related
**/sqlpackage-output/
*.log
*.pid
*.env
docker-compose.override.yml
.docker/

# Ignore publish output
publish/

# Ignore OS junk
.DS_Store
Thumbs.db

# Optional: exclude test coverage reports
coverage/
*.coverage
*.coveragexml

# Optional: secrets (only if stored here, which is not recommended)
secrets.json
.env
.env.*
